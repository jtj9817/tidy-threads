<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Stored apparel isn't drawn on top of the furniture; ASF lists it in the inspect pane instead. -->
  <AdaptiveStorage.GraphicsDef>
    <defName>TT_Dresser_Graphics</defName>
    <targetDef>Dresser</targetDef>
    <showContainedItems>false</showContainedItems>
  </AdaptiveStorage.GraphicsDef>

  <!-- Table_Wardrobe exists with or without VFE (VFE's or our NoVFE copy), so this stays always loaded. -->
  <AdaptiveStorage.GraphicsDef>
    <defName>TT_Wardrobe_Graphics</defName>
    <targetDef>Table_Wardrobe</targetDef>
    <showContainedItems>false</showContainedItems>
  </AdaptiveStorage.GraphicsDef>
</Defs>
