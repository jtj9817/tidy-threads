# Keep executable scripts portable across Git checkouts, including Windows hosts.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.awk text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.svg text eol=lf
LICENSE text eol=lf

# Game textures and screenshot evidence must remain byte-for-byte binary.
*.png binary
